<Window x:Class="Bs2Cooler.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Bs2Cooler.App" Title="BS2 Cooler"
        Width="850" Height="800" MinWidth="760" MinHeight="780" Background="#0E1622" Icon="Assets/Bs2Cooler.ico"
        Foreground="#EDF4FF" FontFamily="Malgun Gothic, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing">
  <Grid Margin="28,24" local:UiMotion.Reveal="True">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid>
      <StackPanel><TextBlock Text="BS2 Cooler" FontSize="28" FontWeight="SemiBold" />
        <TextBlock x:Name="TemperatureSummary" Text="CPU — · GPU — · 목표 70°C" Foreground="#8BE5CA" Margin="0,5,0,0" AutomationProperties.Name="CPU 및 GPU 현재 온도와 목표" /></StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1C3040" CornerRadius="14" Padding="13,7">
        <TextBlock x:Name="ConnectionBadge" Text="연결 확인 중" Foreground="#75DBBF" local:UiMotion.AnimateText="True" />
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Margin="0,22,0,20" Padding="22,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="현재 속도" Foreground="{StaticResource Muted}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock x:Name="ActualRpm" Text="—" FontSize="34" FontWeight="SemiBold" />
            <TextBlock Text="RPM" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="7,0,0,7" /></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="15,0,0,0"><TextBlock Text="목표 속도" Foreground="{StaticResource Muted}" />
          <TextBlock x:Name="TargetRpm" Text="— RPM" FontSize="23" FontWeight="SemiBold" Margin="0,12,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="15,0,0,0"><TextBlock Text="공급 전원" Foreground="{StaticResource Muted}" />
          <TextBlock x:Name="PowerText" Text="확인 중" FontSize="17" Margin="0,10,0,0" />
          <TextBlock x:Name="MaximumText" Text="USB 연결을 기다립니다" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
      <Border x:Name="ManualPanel" Background="{StaticResource Panel}" CornerRadius="12" Padding="22">
        <TabControl x:Name="ControlTabs" Background="Transparent" BorderThickness="0">
          <TabItem Header="수동 제어"><StackPanel Margin="0,14,0,0">
          <TextBlock x:Name="ModeText" Text="장치 연결 후 설정할 수 있습니다" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,20" />
          <UniformGrid Columns="4" Margin="0,0,0,20">
            <Button x:Name="Gear1" Content="1단" Tag="1" Click="OnGearClick" Margin="0,0,6,0" />
            <Button x:Name="Gear2" Content="2단" Tag="2" Click="OnGearClick" Margin="0,0,6,0" />
            <Button x:Name="Gear3" Content="3단" Tag="3" Click="OnGearClick" Margin="0,0,6,0" />
            <Button x:Name="Gear4" Content="4단" Tag="4" Click="OnGearClick" />
          </UniformGrid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
            <TextBox x:Name="RpmInput" Text="2400" KeyDown="OnRpmKeyDown" AutomationProperties.Name="설정할 RPM" />
            <TextBlock Grid.Column="1" Text="RPM" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" />
          </Grid>
          <Slider x:Name="RpmSlider" Minimum="1300" Maximum="2700" Value="2400" TickFrequency="100" SmallChange="100"
                  LargeChange="100" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" Margin="0,19,0,7" AutomationProperties.Name="팬 속도" />
          <DockPanel><TextBlock Text="1300" Foreground="{StaticResource Muted}" FontSize="11" />
            <TextBlock x:Name="SliderMaximum" Text="2700" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" /></DockPanel>
          <Button x:Name="ApplyButton" Content="2단 · 속도 적용" Click="OnApplyClick" Background="#55CBB0" Foreground="#082D27" FontWeight="Bold" Margin="0,23,0,0" />
          <TextBlock x:Name="ApplyNote" Text="설정값은 적용 버튼을 누를 때 전송됩니다." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
          </StackPanel></TabItem>
          <TabItem Header="온도 자동"><StackPanel Margin="0,14,0,0">
            <TextBlock Text="제어 기준" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
            <ComboBox x:Name="TemperatureSource" SelectedIndex="0" SelectionChanged="OnAutomaticSettingsChanged" Padding="7" FontSize="13">
              <ComboBoxItem Content="CPU / GPU 중 더 높은 온도"/>
              <ComboBoxItem Content="GPU 온도만"/>
            </ComboBox>
            <TextBlock Text="냉각 곡선" Foreground="{StaticResource Muted}" Margin="0,16,0,6" />
            <ComboBox x:Name="CurvePreset" SelectedIndex="0" SelectionChanged="OnAutomaticSettingsChanged" Padding="7" FontSize="13">
              <ComboBoxItem Content="성능 · 온도 상승에 빠르게 반응"/>
              <ComboBoxItem Content="저소음 · 낮은 온도에서 조용하게"/>
            </ComboBox>
            <TextBlock x:Name="AutoState" Text="온도 센서를 확인하고 있습니다." TextWrapping="Wrap" Foreground="#8BE5CA" Margin="0,20,0,0" MinHeight="42" />
            <Button x:Name="AutoButton" Content="자동 제어 시작" Click="OnAutomaticClick" Background="#55CBB0" Foreground="#082D27" FontWeight="Bold" Margin="0,12,0,0" />
            <TextBlock Text="70°C 목표 · 60°C부터 최대 풍량, 57°C 미만에서 해제. 냉각 한계로 목표를 넘을 수 있습니다. 중지하면 이전 설정을 복원합니다." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
          </StackPanel></TabItem>
        </TabControl>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="21">
        <StackPanel>
          <TextBlock Text="컴퓨터 온도" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
          <UniformGrid Columns="2">
            <StackPanel><TextBlock Text="CPU" Foreground="{StaticResource Muted}" FontSize="11" /><TextBlock x:Name="CpuTemperature" Text="—" FontSize="25" Margin="0,5,0,0" /></StackPanel>
            <StackPanel><TextBlock Text="GPU" Foreground="{StaticResource Muted}" FontSize="11" /><TextBlock x:Name="GpuTemperature" Text="—" FontSize="25" Margin="0,5,0,0" /></StackPanel>
          </UniformGrid>
          <TextBlock x:Name="SensorDescription" Text="온도 센서 확인 중" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
          <Button x:Name="CpuPermissionButton" Content="CPU 온도 권한으로 다시 실행" Click="OnCpuPermissionClick" Visibility="Collapsed" FontSize="10" Padding="7,8" Margin="0,8,0,0" />
          <Border Height="1" Background="#2C3C50" Margin="0,16,0,16" />
          <TextBlock Text="RGB 조명" Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="RgbButton" Content="확인 중" Click="OnRgbClick" Padding="7,10" FontSize="12"/>
            <Button Grid.Column="2" x:Name="RgbDetailsButton" Content="세부 설정" Click="OnRgbDetailsClick" Padding="7,10" FontSize="12"/>
          </Grid>
          <TextBlock Text="단계 표시등" Foreground="{StaticResource Muted}" Margin="0,15,0,8" />
          <Button x:Name="GearLightButton" Content="확인 중" Click="OnGearLightClick" />
          <Border Height="1" Background="#2C3C50" Margin="0,23,0,16" />
          <TextBlock x:Name="FirmwareText" Text="펌웨어 —" Foreground="{StaticResource Muted}" FontSize="11" />
          <TextBlock Text="로컬 USB 연결" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" />
        </StackPanel>
      </Border>
    </Grid>
    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="StatusText" Text="BS2 Pro를 찾고 있습니다…" Foreground="{StaticResource Muted}" TextWrapping="Wrap" local:UiMotion.AnimateText="True" />
        <TextBlock x:Name="LastUpdatedText" Foreground="#71849F" FontSize="10" Margin="0,4,0,0" />
      </StackPanel>
      <Button Grid.Column="1" x:Name="RefreshButton" Content="다시 연결" Click="OnRefreshClick" Margin="15,0,0,0" Padding="13,8" />
    </Grid>
  </Grid>
</Window>
